                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('nextCursor', pm.response.json().meta.next_cursor || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/water/entries?date={{date}}&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "water",
                "entries"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "cursor",
                  "value": "{{nextCursor}}",
                  "disabled": true
                }
              ]
            },
            "description": "Enable the cursor query parameter only when nextCursor is nonempty."
          },
          "response": []
        },
